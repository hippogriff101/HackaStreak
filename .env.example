# -- Slack app: Socket Mode (bot process) --
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# -- Slack app: OAuth ("Add to Slack", web app process) --
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Must be the tunnel's public HTTPS URL in production, e.g.
# https://hackastreak.example.com/slack/oauth/callback
SLACK_REDIRECT_URI=http://localhost:5000/slack/oauth/callback

# -- Hackatime OAuth ("Verify with Hackatime" on the homepage) --
# Register at https://hackatime.hackclub.com -> My OAuth Apps.
HACKATIME_CLIENT_ID=
HACKATIME_CLIENT_SECRET=
# Must be the tunnel's/Nest's public HTTPS URL in production, e.g.
# https://hackastreak.example.com/hackatime/oauth/callback
HACKATIME_REDIRECT_URI=http://localhost:5000/hackatime/oauth/callback

# -- Database, shared by all three processes --
# Local dev: a plain relative path is fine. In the Portainer/docker-compose
# deployment, point this at the mounted volume, e.g. /app/data/hackastreak.db,
# so redeploying the stack doesn't wipe linked users.
DATABASE_URL=hackastreak.db

# -- Daily reminder / milestone job --
MILESTONE_CHANNEL_ID=
LOW_STREAK_THRESHOLD=1
MILESTONES=7,30,100,365
DAILY_JOB_HOUR=13

# -- Web app --
SESSION_SECRET=
PORT=5000

# -- Admin panel: Hack Club Auth (https://auth.hackclub.com/developer/apps) --
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Must be the tunnel's public HTTPS URL in production, e.g.
# https://hackastreak.example.com/admin/callback
AUTH_REDIRECT_URI=http://localhost:5000/admin/callback
# Comma-separated emails or Slack user IDs allowed into /admin after login.
ADMIN_ALLOWLIST=
