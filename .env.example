# Slack app tokens (api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Slack user IDs who see usage stats on the App Home, comma separated
ADMIN_USER_IDS=U0123456789

# Channel where saying "hackastreak" gets a reaction and help message
PINGWORD_CHANNEL_ID=C0AJLGZ73NE

# Where the SQLite database is stored
DB_PATH=hackastreak.db

LOG_LEVEL=INFO
